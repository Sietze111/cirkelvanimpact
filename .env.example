# ---------------------------------------------------------------
# Frontend (Vite). Only variables starting with VITE_ reach the browser.
# ---------------------------------------------------------------

# Plausible domain, for example www.cirkelvanimpact.nl.
# Leave empty to disable analytics completely.
VITE_PLAUSIBLE_DOMAIN=

# Base path for the build. Use `/cirkelvanimpact/` for a GitHub Pages project
# site and `/` (or leave empty) for Netlify and local development.
VITE_BASE_PATH=

# Cloudflare Turnstile site key (public). Leave empty to hide the widget.
VITE_TURNSTILE_SITE_KEY=

# Force the demo checkout. In development the demo is always used.
# Set to false in production unless you explicitly want a demo.
VITE_DEMO_CHECKOUT=

# Optional: use the real checkout or contact endpoint during local development.
VITE_USE_REAL_CHECKOUT=false
VITE_USE_REAL_CONTACT=false

# ---------------------------------------------------------------
# Netlify Functions (server only, never exposed to the browser)
# ---------------------------------------------------------------

# Mollie API key. Use a test key (test_...) on a deploy preview.
MOLLIE_API_KEY=

# Public site URL, without a trailing slash.
SITE_URL=https://www.cirkelvanimpact.nl

# Resend API key for order confirmations and the contact form.
RESEND_API_KEY=

# Verified sender address in Resend.
CONTACT_FROM_EMAIL=Cirkel van Impact <website@cirkelvanimpact.nl>

# Where contact messages and order notifications go.
CONTACT_TO_EMAIL=info@cirkelvanimpact.nl
ORDER_NOTIFICATION_EMAIL=info@cirkelvanimpact.nl

# Cloudflare Turnstile secret key. Leave empty to skip the server check.
TURNSTILE_SECRET_KEY=
